        {
          "name": "Reserve stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "All-or-nothing decrement under an optimistic lock. Returns the line totals order-service needs.",
            "url": {
              "raw": "{{productBaseUrl}}/api/v1/internal/products/reserve-stock",
              "host": [
                "{{productBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "products",
                "reserve-stock"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderReference\": \"ORD-POSTMAN-0001\",\n  \"items\": [\n    {\n      \"productId\": \"{{seededProductId}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('reservedStock', data.lines[0].remainingStock);",
                  "pm.test('total is unitPrice x quantity', function () {",
                  "  pm.expect(Number(data.totalAmount)).to.eql(Number(data.lines[0].unitPrice) * 2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Release stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Compensating action used when an order is cancelled.",
            "url": {
              "raw": "{{productBaseUrl}}/api/v1/internal/products/release-stock",
              "host": [
                "{{productBaseUrl}}"
              ],
              "path": [
                "api",
