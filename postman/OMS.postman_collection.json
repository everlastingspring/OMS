{
  "info": {
    "_postman_id": "caf04778-4d23-4cd8-b205-bda564a05b64",
    "name": "OMS - Order Management System (Phases 0-2)",
    "description": "user-service (:8081) and product-service (:8082).\n\n**How to run:** import OMS.postman_environment.json, select it, then run `1. Auth > Login (admin)`. It stores `accessToken` in the environment and every other request inherits it through collection-level bearer auth.\n\nFolders are ordered so the whole collection can be run top to bottom in the Collection Runner. Requests that must be unauthenticated (registration, public reads, the 401 and 403 scenarios) override auth to 'noauth' individually.\n\nEvery request carries assertions, so a Collection Runner pass doubles as a smoke test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Each request sends its own correlation id; grep the service logs for it.",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: 'pm-' + Date.now() });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response echoes the correlation id', function () {",
          "  pm.expect(pm.response.headers.has('X-Correlation-Id')).to.be.true;",
          "});",
          "pm.test('responds in under 2s', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "newUserEmail",
      "value": ""
    },
    {
      "key": "newSku",
      "value": ""
    },
    {
      "key": "newCategoryName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Run 'Login (admin)' first - it stores accessToken for every other request.",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Creates a ROLE_USER account. Returns 201. The email is generated per run so the request stays repeatable.",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/auth/register",
              "host": [
                "{{userBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo User\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"User@123\",\n  \"phone\": \"9880000010\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh email each run so re-running the collection does not hit 409.",
                  "pm.collectionVariables.set('newUserEmail', 'demo' + Date.now() + '@oms.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('envelope is successful', function () { pm.expect(body.success).to.be.true; });",
                  "pm.test('password is never returned', function () { pm.expect(body.data.password).to.be.undefined; });",
                  "pm.test('role is forced to USER', function () { pm.expect(body.data.role).to.eql('USER'); });",
                  "pm.environment.set('newUserId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Seeded admin. Stores accessToken in the environment; collection-level bearer auth picks it up.",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/auth/login",
              "host": [
                "{{userBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.data.accessToken);",
                  "pm.environment.set('adminToken', body.data.accessToken);",
                  "pm.environment.set('adminUserId', body.data.user.id);",
                  "pm.test('role is ADMIN', function () { pm.expect(body.data.user.role).to.eql('ADMIN'); });",
                  "pm.test('token type is Bearer', function () { pm.expect(body.data.tokenType).to.eql('Bearer'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Seeded non-admin. Stores userToken so the 403 scenario in folder 5 can use it.",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/auth/login",
              "host": [
                "{{userBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('userToken', body.data.accessToken);",
                  "pm.environment.set('userId', body.data.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
