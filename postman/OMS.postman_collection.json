                },
                {
                  "key": "category",
                  "value": "Electronics",
                  "disabled": true
                },
                {
                  "key": "minPrice",
                  "value": "1000"
                },
                {
                  "key": "maxPrice",
                  "value": "50000"
                },
                {
                  "key": "inStock",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "price,asc"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "const page = pm.response.json().data;",
                  "pm.test('results are sorted by price ascending', function () {",
                  "  const prices = page.content.map(function (p) { return p.price; });",
                  "  const sorted = prices.slice().sort(function (a, b) { return a - b; });",
                  "  pm.expect(prices).to.eql(sorted);",
                  "});",
                  "pm.test('no out-of-stock rows when inStock=true', function () {",
                  "  page.content.forEach(function (p) { pm.expect(p.stockQuantity).to.be.above(0); });",
                  "});"
                ]
              }
            }
          ]
        },
