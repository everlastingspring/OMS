    {
      "name": "5. Error handling",
      "description": "Every status code the GlobalExceptionHandler produces, demonstrated end to end.",
      "item": [
        {
          "name": "400 - validation errors",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Bad email, weak password, short name and a malformed phone in one request.",
            "url": {
              "raw": "{{userBaseUrl}}/api/v1/auth/register",
              "host": [
                "{{userBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"weak\",\n  \"phone\": \"12\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "const body = pm.response.json();",
                  "pm.test('errorCode is VALIDATION_ERROR', function () {",
                  "  pm.expect(body.errorCode).to.eql('VALIDATION_ERROR');",
                  "});",
                  "pm.test('every rejected field is named', function () {",
                  "  const fields = body.errors.map(function (e) { return e.field; });",
                  "  pm.expect(fields).to.include.members(['name','email','password','phone']);",
                  "});"
                ]
              }
            }
          ]
        },
